<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuanLyDanhBa">

        <!-- Màn hình 1: Đăng nhập (Màn hình khởi động đầu tiên) -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình 2: Danh sách liên hệ -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Màn hình 3: Thêm liên hệ -->
        <activity
            android:name=".activity.AddContactActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình Sửa liên hệ -->
        <activity
            android:name=".activity.EditContactActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình 4: Chi tiết liên hệ -->
        <activity
            android:name=".activity.ContactDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
